# Copia este archivo a .env y ajusta los valores.

# IP o nombre DNS con el que se accede a WSO2 y Keycloak desde otras máquinas.
# WSO2 redirige el login de sus consolas a este host y Keycloak lo usa como issuer de los tokens.
# Usa "localhost" para acceso solo local.
PUBLIC_HOST=localhost

# Clave con la que WSO2 cifra los secretos de su base de datos ([encryption] en wso2/deployment.toml).
# Genérala con: openssl rand -hex 32. No la cambies sin borrar el volumen wso2am-db.
WSO2_ENCRYPTION_KEY=
